# Copy to .env.local and fill in values. Never commit real secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack (ZAR)
NEXT_PUBLIC_PAYSTACK_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Public site origin (no trailing slash). Production must be the real host, never localhost:
# NEXT_PUBLIC_SITE_URL=https://www.tikiti.fun
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
TIKITI_VAT_NUMBER=
TIKITI_BILLING_ADDRESS=

# Optional transactional email (Resend). Leave unset to skip sending; in-app onboarding still runs.
# RESEND_FROM_EMAIL must be a verified domain sender, e.g. Tikiti <hello@tikiti.fun>
RESEND_API_KEY=
RESEND_FROM_EMAIL=
