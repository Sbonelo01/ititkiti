# Copy to .env.local and fill in values. Never commit real secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack (ZAR)
NEXT_PUBLIC_PAYSTACK_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Public site origin (no trailing slash). Production must be the real host, never localhost:
# NEXT_PUBLIC_SITE_URL=https://www.tikiti.fun
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SCANNER_APP_URL=https://scan.tikiti.fun
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
TIKITI_VAT_NUMBER=
TIKITI_BILLING_ADDRESS=

# Shared rate limits. Leave unset until
# supabase/migrations/20261105_security_rate_limit_and_user_lookup.sql
# has been reviewed and applied. Unset means process-local counters, not a shared limit.
# Set to true only after that migration. A missing function then fails closed (HTTP 503).
# RATE_LIMIT_DURABLE=true

# Trusted client IP is x-vercel-forwarded-for (then x-real-ip) only when VERCEL=1.
# x-forwarded-for is ignored. Off-platform, callers share one untrusted bucket per route.

# Transactional email via Brevo (organizer welcome and buyer purchase confirmation).
# Purchases and event listing still succeed when these are unset; the server logs a warning.
# BREVO_FROM_EMAIL is a verified sender address, or "Name <email>".
# When unset, the sender is Tikiti <hello@tikiti.fun>. BREVO_FROM_NAME overrides the display name.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=
